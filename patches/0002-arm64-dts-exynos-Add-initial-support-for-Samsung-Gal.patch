From: Hashim <109148083+5wHN28Dg@users.noreply.github.com>
Date: Tue, 6 Oct 2026 22:20:53 +0300
Subject: [PATCH 2/2] arm64: dts: exynos: Add initial support for Samsung
 Galaxy Note9

Add initial device tree for the Exynos 9810 based Samsung Galaxy Note9
(SM-N960F), codename crownlte. It is a close sibling of the Galaxy S9
(starlte).

Only what the upstream SoC support allows: simple-framebuffer for the
bootloader-initialised panel, the hardware keys, RAM below 4 GiB and the
memory regions used by the stock bootloader and firmware.

The memory bank layout and the framebuffer address follow the Galaxy S9;
the bootloader debug page and firmware log window are taken from Galaxy
S9+ reports. The other reserved regions and the keys come from the vendor
kernel for this phone.

Assisted-by: LLM
---
 arch/arm64/boot/dts/exynos/Makefile           |   1 +
 .../boot/dts/exynos/exynos9810-crownlte.dts   | 182 ++++++++++++++++++
 2 files changed, 183 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos9810-crownlte.dts

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index 8c48ce2e0..04fdc27ea 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -16,6 +16,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos850-e850-96.dtb		\
 	exynos8855-smdk.dtb		\
 	exynos8895-dreamlte.dtb		\
+	exynos9810-crownlte.dtb		\
 	exynos9810-starlte.dtb		\
 	exynos990-c1s.dtb		\
 	exynos990-r8s.dtb               \
diff --git a/arch/arm64/boot/dts/exynos/exynos9810-crownlte.dts b/arch/arm64/boot/dts/exynos/exynos9810-crownlte.dts
new file mode 100644
index 000000000..1058674d2
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9810-crownlte.dts
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy Note9 (crownlte/SM-N960F) device tree source
+ */
+
+/dts-v1/;
+#include "exynos9810.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Samsung Galaxy Note9 (SM-N960F)";
+	compatible = "samsung,crownlte", "samsung,exynos9810";
+	chassis-type = "handset";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		framebuffer@cc000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;
+			width = <1440>;
+			height = <2960>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_bixby &key_power &key_voldown &key_volup>;
+		pinctrl-names = "default";
+
+		bixby-key {
+			label = "Bixby";
+			linux,code = <KEY_ASSISTANT>;
+			gpios = <&gpa0 6 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		power-key {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
+		};
+
+		volup-key {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/*
+	 * Only RAM below 4 GiB, with the same holes as on the Galaxy S9. The
+	 * phone has more RAM, but its bank layout is not known yet.
+	 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3c800000>,
+		      <0x0 0xc0000000 0x20000000>,
+		      <0x0 0xe1900000 0x1e700000>;
+	};
+
+	/* Regions the stock bootloader and firmware use. */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Written by the bootloader before the kernel starts (as on S9+) */
+		debug-magic@80000000 {
+			reg = <0x0 0x80000000 0x2000>;
+			no-map;
+		};
+
+		/* Firmware logs, still written after the kernel starts (as on S9+) */
+		firmware-log@90000000 {
+			reg = <0x0 0x90000000 0x179c000>;
+			no-map;
+		};
+
+		ect@a0000000 {
+			reg = <0x0 0xa0000000 0x32000>;
+			no-map;
+		};
+
+		/* Disabled in the vendor kernel, kept out to be safe */
+		rkp@af600000 {
+			reg = <0x0 0xaf600000 0x2400000>;
+			no-map;
+		};
+
+		/* Disabled in the vendor kernel, kept out to be safe */
+		tima@b8000000 {
+			reg = <0x0 0xb8000000 0x200000>;
+			no-map;
+		};
+
+		seclog@c0000000 {
+			reg = <0x0 0xc0000000 0x80000>;
+			no-map;
+		};
+
+		framebuffer@cc000000 {
+			reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;
+			no-map;
+		};
+
+		secure-camera@e1900000 {
+			reg = <0x0 0xe1900000 0x1e00000>;
+			no-map;
+		};
+
+		modem@f0000000 {
+			reg = <0x0 0xf0000000 0x9200000>;
+			no-map;
+		};
+
+		modem-log@f9200000 {
+			reg = <0x0 0xf9200000 0x2000000>;
+			no-map;
+		};
+
+		abox@fb200000 {
+			reg = <0x0 0xfb200000 0x2800000>;
+			no-map;
+		};
+
+		debug-snapshot@fda00000 {
+			reg = <0x0 0xfda00000 0x1c08000>;
+			no-map;
+		};
+
+		camera-firmware@ff800000 {
+			reg = <0x0 0xff800000 0x800000>;
+			no-map;
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&pinctrl_alive {
+	key_bixby: key-bixby-pins {
+		samsung,pins = "gpa0-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_power: key-power-pins {
+		samsung,pins = "gpa2-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
