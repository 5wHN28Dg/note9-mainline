# Config fragment merged on top of arm64 defconfig by scripts/build.sh.
# Milestone 1: kernel log on the screen, buttons respond.

# kernel/init.c needs these (defconfig has them today; listing them makes
# scripts/build.sh fail if that ever changes).
CONFIG_DEVTMPFS=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y

# Show the log on the framebuffer S-Boot leaves set up (simplefb).
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Ignore whatever command line the bootloader passes; print everything.
CONFIG_CMDLINE="console=tty0 ignore_loglevel"
CONFIG_CMDLINE_FORCE=y
# The S9+ port only got past early boot with 48-bit virtual addresses
# (SheroAbi galaxy-s9plus-mainline-linux, docs/06-known-issues.md).
CONFIG_ARM64_VA_BITS_48=y
# Fixed kernel addresses make blind debugging (pstore, crashes) easier.
# CONFIG_RANDOMIZE_BASE is not set

# Power hardware is off-limits until its own milestone (CLAUDE.md).
# None of these has a node in our DT, but keep them out of the image anyway.
# CONFIG_MFD_MAX77705 is not set
# CONFIG_CHARGER_MAX77705 is not set
# CONFIG_BATTERY_MAX17042 is not set
# CONFIG_BATTERY_MAX1720X is not set
# CONFIG_MFD_SEC_I2C is not set
# CONFIG_MFD_SEC_ACPM is not set
# CONFIG_REGULATOR_S2MPS11 is not set
# CONFIG_EXYNOS_THERMAL is not set
# CONFIG_CPU_FREQ is not set
